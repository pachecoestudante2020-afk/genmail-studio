<Window x:Class="GenMail.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GenMail Studio"
        Height="780"
        Width="980"
        MinHeight="640"
        MinWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Input" Grid.Row="0" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Browse .txt" Command="{Binding BrowseInputFileCommand}" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Domain" Grid.Column="0" Margin="0,0,8,0">
                <StackPanel Margin="8">
                    <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Number Settings" Grid.Column="1" Margin="8,0,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Number Mode" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding NumberMode}" ItemsSource="{Binding NumberModes}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Placement" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding NumberPlacementMode}" ItemsSource="{Binding NumberPlacementModes}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Range" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NumberRangeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Rules" Grid.Column="0" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="180" Margin="8">
                    <ItemsControl ItemsSource="{Binding RuleOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Id}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
            <GroupBox Header="Modes" Grid.Column="1" Margin="8,0,8,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Dedupe" />
                    <ComboBox Grid.Row="0" Margin="0,20,0,8" SelectedItem="{Binding DedupeMode}" ItemsSource="{Binding DedupeModes}" />
                    <TextBlock Grid.Row="1" Text="Alias Filter" />
                    <ComboBox Grid.Row="1" Margin="0,20,0,0" SelectedItem="{Binding AliasFilterMode}" ItemsSource="{Binding AliasFilterModes}" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Safety" Grid.Column="2" Margin="8,0,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="Max Output Emails" />
                    <TextBox Grid.Row="0" Margin="0,20,0,8" Text="{Binding MaxOutputEmails, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Max Numbers Per Base" />
                    <TextBox Grid.Row="1" Margin="0,20,0,8" Text="{Binding MaxNumbersPerBase, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Row="2" Content="Split output into multiple files" IsChecked="{Binding SplitOutputFiles}" Margin="0,4,0,8" />
                    <TextBlock Grid.Row="3" Text="Rows per output file" />
                    <TextBox Grid.Row="3" Margin="0,20,0,8" Text="{Binding RowsPerOutputFile, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SplitOutputFiles}" />
                    <TextBlock Grid.Row="4" TextWrapping="Wrap" FontSize="11" Text="The app will not generate extra data to fill files. The last file may contain fewer rows." />
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Header="Progress" Grid.Row="3" Margin="0,0,0,8">
            <UniformGrid Columns="5" Margin="8">
                <StackPanel>
                    <TextBlock Text="Input Lines" FontWeight="Bold" />
                    <TextBlock Text="{Binding InputLinesRead}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Candidates" FontWeight="Bold" />
                    <TextBlock Text="{Binding CandidatesGenerated}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Emails" FontWeight="Bold" />
                    <TextBlock Text="{Binding EmailsWritten}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Duplicates" FontWeight="Bold" />
                    <TextBlock Text="{Binding DuplicatesSkipped}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Quality Rejected" FontWeight="Bold" />
                    <TextBlock Text="{Binding QualityRejected}" />
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <GroupBox Header="Output" Grid.Row="4" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding OutputFolder}" IsReadOnly="True" Margin="0,0,8,8" />
                <Button Grid.Row="0" Grid.Column="1" Content="Open Folder" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Estimate" Width="110" Margin="0,0,8,0" Command="{Binding EstimateCommand}" />
            <Button Content="Start" Width="110" Margin="0,0,8,0" Command="{Binding StartCommand}" />
            <Button Content="Cancel" Width="110" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
